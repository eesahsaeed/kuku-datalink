PORT=3001
NODE_ENV=development

# Core
MONGO_URI=
JWT_SECRET=

# URLs
FRONTEND_URL=https://kuku.com.ng
BACKEND_URL=https://kuku-ahjz.onrender.com
AUTH_FRONTEND_URL=https://kuku-ahjz.onrender.com
VITE_API_BASE_URL=https://kuku-ahjz.onrender.com
# Optional: override digest tracking pixel host (useful for ngrok/local testing)
# SUPPORT_TRACKING_BASE_URL=
MOBILE_APP_SCHEME=kukumobile

# Google OAuth
VITE_GOOGLE_CLIENT_ID=
GOOGLE_EXPO_ANDROID_CLIENT_ID=
GOOGLE_EXPO_IOS_CLIENT_ID=

# Aidapay
AIDAPAY_ACCESS_TOKEN=
AIDAPAY_PIN=
AIDAPAY_LIVE_MODE=false
AIDAPAY_DEBUG_LOGS=false
# When false, Aidapay stays on the legacy non-webhook flow.
AIDAPAY_WEBHOOK_ENABLED=false

# Directortech
DIRECTORTECH_LIVE_MODE=false
DIRECTORTECH_AIRTIME_TEST_MODE=false
DIRECTORTECH_BASE_URL=https://directortechs.com
DIRECTORTECH_USERNAME=
DIRECTORTECH_PASSWORD=
DIRECTORTECH_ACCESS_TOKEN=

# Optional: Aidapay provider code to use when 9mobile falls back to helper data
# NINEMOBILE_AIDAPAY_PROVIDER_CODE=9mobile-sme

# Paystack
PAYSTACK_MODE=live
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_TEST_SECRET_KEY=

# Support mailboxes
SUPPORT_EMAIL=
SUPPORT_PASSWORD=
# Required to enable the incoming support mailbox listener; use your mail provider's IMAP hostname.
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_SECURE=true
NOREPLY_EMAIL=
NOREPLY_PASSWORD=

# Optional
# SOCKET_ALLOWED_ORIGINS=
# PAYSTACK_PREFERRED_BANK=
# PAYSTACK_ENFORCE_IP_WHITELIST=false
# WALLET_TEST_TOOLS=false
# REWARDS_ENABLED=false
# VITE_REWARDS_ENABLED=false
# Adsterra (publisher monetization)
# These default to the currently configured live script URLs in code.
# Override here if Adsterra rotates your zone links.
# VITE_ADSTERRA_ENABLED=true
# VITE_ADSTERRA_IFRAME_KEY=
# VITE_ADSTERRA_IFRAME_SCRIPT_URL=
# VITE_ADSTERRA_IFRAME_FORMAT=iframe
# VITE_ADSTERRA_IFRAME_HEIGHT=60
# VITE_ADSTERRA_IFRAME_WIDTH=468
# VITE_ADSTERRA_CONTAINER_SCRIPT_URL=
# VITE_ADSTERRA_CONTAINER_ID=
# VITE_ADSTERRA_DIRECT_LINK_URL=
# VITE_ADSTERRA_DIRECT_LINK_LABEL=Open sponsored offer
# ADMAVEN_API_TOKEN=
# ADMAVEN_PUSH_TAG=
# ADMAVEN_POPUNDER_TAG=
# ADMAVEN_CONTENT_LOCKER_SUB_ID=
# ADMAVEN_SUB_ID=
# REWARD_CLAIM_TTL_MINUTES=45
# REWARD_CLAIM_MAX_AGE_MINUTES=120
# REWARD_CLAIM_PREPARE_TIMEOUT_MS=15000
# DEV_HEALTHCHECK_PUSH_ENABLED=true
# DEV_HEALTHCHECK_PUSH_TOKEN=ExpoPushToken[xxxxxxxxxxxxxxxxxxxxxx]
# DEV_HEALTHCHECK_PUSH_TOKENS=ExpoPushToken[xxxxx],ExpoPushToken[yyyyy]
# DEV_HEALTHCHECK_PUSH_EMAIL=you@example.com
# DEV_HEALTHCHECK_PUSH_COOLDOWN_MS=30000
# PURCHASE_AUTO_REQUERY_TIMEOUT_MS=60000
# PURCHASE_AUTO_REQUERY_CRON_SCHEDULE=*/5 * * * *
