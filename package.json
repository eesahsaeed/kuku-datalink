{
  "name": "kuku-data",
  "version": "0.0.0",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "server:dev": "nodemon src/server.js",
    "server:build": "npm run clean && npx babel src --verbose --out-dir dist --ignore \"src/app/**\" --copy-files",
    "client:build": "npx vite build",
    "build": "npm run server:build && npm run client:build",
    "serve": "vite preview",
    "test": "prettier --check . && eslint . && stylelint \"**/*.css\" --allow-empty-input",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.23.0",
    "@babel/plugin-transform-optional-chaining": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@vitejs/plugin-react": "^1.0.2",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.2.2",
    "concurrently": "^6.2.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "http-proxy-middleware": "^2.0.1",
    "husky": "^7.0.2",
    "lint-staged": "^11.1.2",
    "nodemon": "^2.0.13",
    "prettier": "2.4.1",
    "prop-types": "^15.7.2",
    "rimraf": "^3.0.2",
    "sass": "1.70",
    "stylelint": "^13.13.1",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-standard": "^22.0.0",
    "vite": "^4.3.0",
    "vite-jsconfig-paths": "^2.0.1"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.26",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^4.6.2",
    "chart.js": "^4.5.1",
    "classnames": "^2.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^7.2.0",
    "express": "^4.17.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "imap": "^0.8.19",
    "imapflow": "^1.2.6",
    "jsonwebtoken": "^9.0.3",
    "mail-listener5": "^2.1.2",
    "mailparser": "^3.9.1",
    "mongoose": "^9.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "react": "^19.2.3",
    "react-aria": "^3.48.0",
    "react-aria-components": "^1.17.0",
    "react-chartjs-2": "^5.3.0",
    "react-confetti": "^6.4.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-currency-input-field": "^4.0.3",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.2",
    "react-stately": "^3.46.0",
    "react-use": "^17.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "styled-components": "^6.3.8",
    "uuid": "^13.0.0"
  }
}
